//description

#define VisualizeLigamentNodes 1


Main.HumanModel.BodyModel.Trunk.Segments.C2Seg = {
  
  // anterior longitudinal
  AnyRefNode ALLNodeSuperior = {sRel = .Scale({0.040,0.567,0});};
  AnyRefNode ALLNodeInferior = {sRel = .Scale({0.043,0.5555,0});};
  
  // posterior longitudinal
  AnyRefNode PLLNodeSuperior = {sRel = .Scale({0.028, 0.569, 0});};
  AnyRefNode PLLNodeInferior = {sRel = .Scale({0.0265,0.554,0});};
  
  #if VisualizeLigamentNodes
  
  AnyDrawSphere Draw_ALLNodeInferior = 
  { //RGB = {0.8, 0.2, 0.2};
    ScaleXYZ = {0.002, 0.002, 0.002};
    Position = .ALLNodeInferior.sRel;
    //GlobalCoord = Off;
  };
  
  AnyDrawSphere Draw_ALLNodeSuperior = 
  { //RGB = {0.8, 0.2, 0.2};
    ScaleXYZ = {0.002, 0.002, 0.002};
    Position = .ALLNodeSuperior.sRel;
    //GlobalCoord = Off;
  };
  
   AnyDrawSphere Draw_PLLNodeSuper = 
  { //RGB = {0.8, 0.2, 0.2};
    ScaleXYZ = {0.002, 0.002, 0.002};
    Position = .PLLNodeSuperior.sRel;
    //GlobalCoord = Off;
  };
  
  AnyDrawSphere Draw_PLLNodeInferior = 
  { //RGB = {0.8, 0.2, 0.2};
    ScaleXYZ = {0.002, 0.002, 0.002};
    Position = .PLLNodeInferior.sRel;
    //GlobalCoord = Off;
  };
  
  #endif
  
}; //C2Seg

