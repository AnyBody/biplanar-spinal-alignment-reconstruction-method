Main.HumanModel.BodyModel.Trunk.Segments.C7Seg = {
  
  
  // anterior longitudinal
  AnyRefNode ALLNodeInferior = {sRel = .Scale({0.026,0.460,0});};
  AnyRefNode ALLNodeSuperior = {sRel = .Scale({0.0315,0.4745,0});};
  
  // posterior longitudinal
  AnyRefNode PLLNodeSuperior = {sRel = .Scale({0.012, 0.4815, 0});};
  AnyRefNode PLLNodeInferior = {sRel = .Scale({0.0045,0.4665,0});};
  
  AnyRefNode &PostSup = PLLNodeSuperior;
AnyRefNode &AntSup = ALLNodeSuperior;
AnyRefNode &PostInf = PLLNodeInferior;
AnyRefNode &AntInf = ALLNodeInferior;


// Superior endplate
AnyRefNode Endplate_sup = {
  sRel = .PostSup.sRel;
  ARel = RotMat(sRel, .AntSup.sRel, sRel +{0.0,0.1,0.0});   
};

// Inferior endplate
AnyRefNode Endplate_inf = {
  sRel = .PostInf.sRel;
  ARel = RotMat(sRel, .AntInf.sRel, sRel +{0.0,0.1,0.0});
};

  
  #if VisualizeLigamentNodes
  
  AnyDrawSphere Draw_ALLNodeInferior = 
  { //RGB = {0.8, 0.2, 0.2};
    ScaleXYZ = {0.002, 0.002, 0.002};
    Position = .ALLNodeInferior.sRel;
    //GlobalCoord = Off;
  };
  
  AnyDrawSphere Draw_ALLNodeSuperior = 
  { //RGB = {0.8, 0.2, 0.2};
    ScaleXYZ = {0.002, 0.002, 0.002};
    Position = .ALLNodeSuperior.sRel;
    //GlobalCoord = Off;
  };
  
  AnyDrawSphere Draw_PLLNodeSuper = 
  { //RGB = {0.8, 0.2, 0.2};
    ScaleXYZ = {0.002, 0.002, 0.002};
    Position = .PLLNodeSuperior.sRel;
    //GlobalCoord = Off;
  };
  
  AnyDrawSphere Draw_PLLNodeInferior = 
  { //RGB = {0.8, 0.2, 0.2};
    ScaleXYZ = {0.002, 0.002, 0.002};
    Position = .PLLNodeInferior.sRel;
    //GlobalCoord = Off;
  };
  
  #endif
  
}; //C7Seg

