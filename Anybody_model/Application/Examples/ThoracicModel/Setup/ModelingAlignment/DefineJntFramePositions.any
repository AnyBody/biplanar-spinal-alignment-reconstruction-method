AnyFolder DefineJointPositions = {
  
  //SacrumPelvis joint node
  AnyOperationSetValue SetJntPos_SacrumPelvis = {
    
    AnyFolder &SegSup = Main.HumanModel.BodyModel.Trunk.Segments.SacrumSeg;
    AnyFolder &SegInf = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg;
    
    AnyFolder &SegSupJnt = SegSup.SacrumPelvisJntNode;
    AnyFolder &SegInfJnt = SegInf.PelvisSacrumJntNode;
    
    AnyVec3 HalfDistance = (SegSupJnt.r - SegInfJnt.r)*0.5; 
       
    AnyVec3 sup_jnt_node_pos = SegSupJnt.sRel - HalfDistance * SegSup.Axes;
    AnyVec3 inf_jnt_node_pos = SegInfJnt.sRel +  HalfDistance * SegInf.Axes;
    
    Source = {&sup_jnt_node_pos, &inf_jnt_node_pos};
    
    Target = {&SegSupJnt.sRel, &SegInfJnt.sRel};
    
  }; //SetJntPos_SacrumPelvis

  
  
