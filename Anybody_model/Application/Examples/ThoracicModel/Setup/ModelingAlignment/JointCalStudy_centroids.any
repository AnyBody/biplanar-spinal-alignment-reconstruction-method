      CType = {Hard, Hard, Hard};
    };
    
    AnyKinEqSimpleDriver C3_centroid = {
      AnyKinLinear centroid_pos = {
        AnyRefFrame &ground = ...Centroids_Calib_Ref;
        AnyRefFrame &u1 = ...Segs_cervical.C3Seg.Vertebral_orient;     
        Ref=0;
      };
      DriverPos = {..input.C3_x, ..input.C3_y, ..input.C3_z};
      DriverVel = {0,0,0};
      Reaction.Type = {On,On,On};
      CType = {Hard, Hard, Hard};
    };
    
    AnyKinEqSimpleDriver C2_Inf_centroid = {
      AnyKinLinear centroid_pos = {
        AnyRefFrame &ground = ...Centroids_Calib_Ref;
        AnyRefFrame &u1 = ...Segs_cervical.C2Seg.Inf_EP_orient;    
        Ref=0;
      };
      DriverPos = {..input.C2_x, ..input.C2_y, ..input.C2_z};
      DriverVel = {0,0,0};
      Reaction.Type = {On,On,On};
      CType = {Hard, Hard, Hard};
    };
    };
    
    #endif
    
    // ------------------------------------------------
    // ------------- Rotation drivers -----------------
    // ------------------------------------------------
    // --------- set segments orientations ------------
