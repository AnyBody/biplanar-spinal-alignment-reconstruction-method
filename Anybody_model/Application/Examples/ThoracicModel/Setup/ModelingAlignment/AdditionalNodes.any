Main.HumanModel.BodyModel.Trunk.Segments.SacrumSeg = {

  AnyRefNode SacralMidPointNode = {
    sRel = (.ALLNodeSuperior.sRel + .PLLNodeSuperior.sRel) / 2;

    AnyDrawNode DrwNode = {
      ScaleXYZ = ..Scale({0.004, 0.004, 0.004});
      RGB = {0, 1, 0};
    };

    AnyDrawRefFrame SacralEndplateNodeDrw = {
      ScaleXYZ = ..Scale({0.001, 0.001, 0.001});
      RGB = {0, 1, 0};
    };
  };

  AnyRefNode &Endplate_Frame = Endplate_sup;

};

Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg = {

  AnyKinPLine HipCenterToS1Mid = {
    AnyRefNode &ref1 = .HipJointsCenter;
    AnyRefNode &ref2 = ..SacrumSeg.SacralMidPointNode;
    AnyDrawPLine drw = {Thickness = 0.002; RGB = {0, 0, 0};};
  };

  AnyRefNode HipCenter_S1Mid_Frame = {
    sRel = .HipJointsCenter.sRel;
    AnyVector SacrumPoint =.PelvisSacrumJntNode.sRel - ..SacrumSeg.SacrumPelvisJntNode.sRel + ..SacrumSeg.SacralMidPointNode.sRel;
    ARel = RotMat(sRel, SacrumPoint, -{0.1, 0.0, 0.0}) * RotMat(-pi / 2, z);
  };

  AnyRefNode HipJointsCenter = {
    sRel = .Scale({0.03, -0.10, 0});
    AnyDrawNode DrwNode = {
      ScaleXYZ = {0.005, 0.005, 0.005};
      RGB = {0.8, 0, 0.2};
    };
  };
  
}; 


