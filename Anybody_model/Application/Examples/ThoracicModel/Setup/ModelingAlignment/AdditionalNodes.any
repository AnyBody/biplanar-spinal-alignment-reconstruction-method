// Define points to allow postural measurements
Main.HumanModel.BodyModel.Trunk.Segments.T1Seg = {
  AnyRefNode C7CentreNode = {  
    sRel = .Scale({0.017, 0.471, 0});
    AnyDrawNode C7Centre = {
      ScaleXYZ = 0.002*{1,1,1};
      RGB={0.5,0,0.5};
    };
  }; 
  
  AnyRefNode T1_node = {  
    sRel=.Scale({0.012,0.452,0});
  };   
};

Main.HumanModel.BodyModel.Trunk.Segments.T1Seg = {
 AnyRefNode T1GlobalOrient = {
     sRel = .T1_node.sRel;
   }; 
};


Main.HumanModel.BodyModel.Trunk.Segments.T2Seg = {
  AnyRefNode T2GlobalOrient = {
    sRel  = (.PostSup.sRel + .AntSup.sRel + .PostInf.sRel + .AntInf.sRel) * 0.25;
  };
};


