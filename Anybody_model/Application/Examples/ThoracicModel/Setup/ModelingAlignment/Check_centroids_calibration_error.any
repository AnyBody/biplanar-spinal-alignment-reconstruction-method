AnyVar L1_error_rotZ = modelmeasures.L1GlobalRot_AngleZ - Main.SubjectData.Alignment.Angle_L1;
AnyVar L2_error_rotZ = modelmeasures.L2GlobalRot_AngleZ - Main.SubjectData.Alignment.Angle_L2;
AnyVar L3_error_rotZ = modelmeasures.L3GlobalRot_AngleZ - Main.SubjectData.Alignment.Angle_L3;
