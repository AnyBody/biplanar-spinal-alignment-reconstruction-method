AnyVec3 T5_error_pos = {ce.T5Pos.Pos[0] - Main.SubjectData.Alignment.T5_x, ce.T5Pos.Pos[1] - Main.SubjectData.Alignment.T5_y, ce.T5Pos.Pos[2] - Main.SubjectData.Alignment.T5_z};
AnyVec3 T6_error_pos = {ce.T6Pos.Pos[0] - Main.SubjectData.Alignment.T6_x, ce.T6Pos.Pos[1] - Main.SubjectData.Alignment.T6_y, ce.T6Pos.Pos[2] - Main.SubjectData.Alignment.T6_z};
AnyVec3 T7_error_pos = {ce.T7Pos.Pos[0] - Main.SubjectData.Alignment.T7_x, ce.T7Pos.Pos[1] - Main.SubjectData.Alignment.T7_y, ce.T7Pos.Pos[2] - Main.SubjectData.Alignment.T7_z};
AnyVec3 T8_error_pos = {ce.T8Pos.Pos[0] - Main.SubjectData.Alignment.T8_x, ce.T8Pos.Pos[1] - Main.SubjectData.Alignment.T8_y, ce.T8Pos.Pos[2] - Main.SubjectData.Alignment.T8_z};
AnyVec3 T9_error_pos = {ce.T9Pos.Pos[0] - Main.SubjectData.Alignment.T9_x, ce.T9Pos.Pos[1] - Main.SubjectData.Alignment.T9_y, ce.T9Pos.Pos[2] - Main.SubjectData.Alignment.T9_z};
AnyVec3 T10_error_pos = {ce.T10Pos.Pos[0] - Main.SubjectData.Alignment.T10_x, ce.T10Pos.Pos[1] - Main.SubjectData.Alignment.T10_y, ce.T10Pos.Pos[2] - Main.SubjectData.Alignment.T10_z};
AnyVec3 T11_error_pos = {ce.T11Pos.Pos[0] - Main.SubjectData.Alignment.T11_x, ce.T11Pos.Pos[1] - Main.SubjectData.Alignment.T11_y, ce.T11Pos.Pos[2] - Main.SubjectData.Alignment.T11_z};
AnyVec3 T12_error_pos = {ce.T12Pos.Pos[0] - Main.SubjectData.Alignment.T12_x, ce.T12Pos.Pos[1] - Main.SubjectData.Alignment.T12_y, ce.T12Pos.Pos[2] - Main.SubjectData.Alignment.T12_z};

AnyVec3 L1_error_pos = {ce.L1Pos.Pos[0] - Main.SubjectData.Alignment.L1_x, ce.L1Pos.Pos[1] - Main.SubjectData.Alignment.L1_y, ce.L1Pos.Pos[2] - Main.SubjectData.Alignment.L1_z};
AnyVec3 L2_error_pos = {ce.L2Pos.Pos[0] - Main.SubjectData.Alignment.L2_x, ce.L2Pos.Pos[1] - Main.SubjectData.Alignment.L2_y, ce.L2Pos.Pos[2] - Main.SubjectData.Alignment.L2_z};
AnyVec3 L3_error_pos = {ce.L3Pos.Pos[0] - Main.SubjectData.Alignment.L3_x, ce.L3Pos.Pos[1] - Main.SubjectData.Alignment.L3_y, ce.L3Pos.Pos[2] - Main.SubjectData.Alignment.L3_z};
AnyVec3 L4_error_pos = {ce.L4Pos.Pos[0] - Main.SubjectData.Alignment.L4_x, ce.L4Pos.Pos[1] - Main.SubjectData.Alignment.L4_y, ce.L4Pos.Pos[2] - Main.SubjectData.Alignment.L4_z};
AnyVec3 L5_error_pos = {ce.L5Pos.Pos[0] - Main.SubjectData.Alignment.L5_x, ce.L5Pos.Pos[1] - Main.SubjectData.Alignment.L5_y, ce.L5Pos.Pos[2] - Main.SubjectData.Alignment.L5_z};


// calculate error between actual vertebral orientations and input

AnyFolder &modelmeasures = Main.PostureCalibration.CalStudy_centroids.Drivers.measures;

#if IncludeNeckCalibration == 1
AnyVar C2_error_rot = modelmeasures.C2InferiorRot.Pos[2]*180/pi - Main.SubjectData.Alignment.Angle_C2;
AnyVar C3_error_rot = modelmeasures.C3GlobalRot.Pos[2]*180/pi - Main.SubjectData.Alignment.Angle_C3;
AnyVar C4_error_rot = modelmeasures.C4GlobalRot.Pos[2]*180/pi - Main.SubjectData.Alignment.Angle_C4;
AnyVar C5_error_rot = modelmeasures.C5GlobalRot.Pos[2]*180/pi - Main.SubjectData.Alignment.Angle_C5;
AnyVar C6_error_rot = modelmeasures.C6GlobalRot.Pos[2]*180/pi - Main.SubjectData.Alignment.Angle_C6;
AnyVar C7_error_rot = modelmeasures.C7GlobalRot.Pos[2]*180/pi - Main.SubjectData.Alignment.Angle_C7;
#endif

AnyVar L1S1_error_rotZ = modelmeasures.LL_L1S1 - Main.SubjectData.Alignment.LL;
AnyVar L4S1_error_rotZ = modelmeasures.LL_L4S1 - Main.SubjectData.Alignment.L4S1L;
AnyVar C7VT_error_rotZ = modelmeasures.C7_MovingFrame.SacrC7OrientationMeasure.Pos[0] - (90 - Main.SubjectData.Alignment.T1GT + Main.SubjectData.Alignment.PT);
AnyVar T5T12_error_rotZ = modelmeasures.TK_T5T12 - Main.SubjectData.Alignment.T5_T12_Kifoz;
AnyVar T2T5_error_rotZ = modelmeasures.TK_T2T5 - Main.SubjectData.Alignment.T2_T5_Kifoz;
AnyVar T10L2_error_rotZ = modelmeasures.TK_T10L2 - Main.SubjectData.Alignment.T10_L2_Kifoz;

AnyVar T1_error_rotZ = modelmeasures.T1GlobalRot_AngleZ - Main.SubjectData.Alignment.Angle_T1;
