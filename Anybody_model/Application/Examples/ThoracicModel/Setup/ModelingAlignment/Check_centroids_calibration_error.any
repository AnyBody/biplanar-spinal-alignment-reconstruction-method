// check the error for the respective vertebral coordinates and the input values wrt 
// to the calibration reference frame

AnyFolder Centroids_error = {
  
  AnyFolder &Input_points = Main.HumanModel.BodyModel.Trunk.Segments;
  AnyFolder &segs = Main.HumanModel.BodyModel.Trunk.Segments;
  
  AnyRefFrame &Centroids_Check_Ref = Main.HumanModel.BodyModel.Trunk.Segments.SacrumSeg.CS4Node_MidLR;
  
  Main.HumanModel.BodyModel.Trunk.Segments.SacrumSeg.CS4Node_MidLR = {
    AnyDrawNode CSRNodeMid = { ScaleXYZ={1,1,1}*0.006; Visible = On; RGB = {0.9,0.5,0};};
  };
  

  //  // ------------------------------------------------------------
  //  // ------ measure distance between calibration reference ------
  //  // --------------- system and vertebral centroid --------------
  //  // ------------------------------------------------------------
  
  // AnyKinLinear by default finds distance between two nodes/frames, expressed in global coordinates system
  
  //bifemoral-head axis
  AnyKinLinear FHPos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &L5_centroid = .segs.PelvisSeg.HipJointsCenter;
  };
  
  //lumbar vertebra
  AnyKinLinear L5Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &L5_centroid = .segs.L5Seg.Vertebral_orient;
  };
  
  AnyKinLinear L4Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &L4_centroid = .segs.L4Seg.Vertebral_orient;
  };
  
  AnyKinLinear L3Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &L3_centroid = .segs.L3Seg.Vertebral_orient;
  };
  
  AnyKinLinear L2Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &L2_centroid = .segs.L2Seg.Vertebral_orient;
  };
  
  AnyKinLinear L1Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &L1_centroid = .segs.L1Seg.Vertebral_orient;
  };
  
  //thoracic vertebra
  AnyKinLinear T12Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &T12_centroid = .segs.T12Seg.Vertebral_orient;
  };
  
  AnyKinLinear T11Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &T11_centroid = .segs.T11Seg.Vertebral_orient;
  };
  
  AnyKinLinear T10Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &T10_centroid = .segs.T10Seg.Vertebral_orient;
  };
  
  AnyKinLinear T9Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &T9_centroid = .segs.T9Seg.Vertebral_orient;
  };
  
  AnyKinLinear T8Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &T8_centroid = .segs.T8Seg.Vertebral_orient;
  };
  
  AnyKinLinear T7Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &T7_centroid = .segs.T7Seg.Vertebral_orient;
  };
  
  AnyKinLinear T6Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &T6_centroid = .segs.T6Seg.Vertebral_orient;
  };
  
  AnyKinLinear T5Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &T5_centroid = .segs.T5Seg.Vertebral_orient;
  };
  
  AnyKinLinear T4Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &T4_centroid = .segs.T4Seg.Vertebral_orient;
  };
  
  AnyKinLinear T3Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &T3_centroid = .segs.T3Seg.Vertebral_orient;
  };
  
  AnyKinLinear T2Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &T2_centroid = .segs.T2Seg.Vertebral_orient;
  };
  
  AnyKinLinear T1Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &T1_centroid = .segs.T1Seg.Vertebral_orient;
  };
  
  #if IncludeNeckCalibration == 1
  
  //cervical vertebra
  AnyKinLinear C7Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &C7_centroid = .segs.C7Seg.Vertebral_orient;
  };
  
  AnyKinLinear C6Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &C6_centroid = .segs.C6Seg.Vertebral_orient;
  };
  
  AnyKinLinear C5Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &C5_centroid = .segs.C5Seg.Vertebral_orient;
  };
  
  AnyKinLinear C4Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &C4_centroid = .segs.C4Seg.Vertebral_orient;
  };
  
  AnyKinLinear C3Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &C3_centroid = .segs.C3Seg.Vertebral_orient;
  };
  
  AnyKinLinear C2Pos = {
    AnyRefFrame &Error_check_Ref = .Centroids_Check_Ref;
    AnyRefFrame &C2_centroid = .segs.C2Seg.Inf_EP_orient;
  };
  
  #endif
}; // End of Cenroids_error folder


// calculate error between actual centroids coordinates and input

AnyFolder &ce = Centroids_error;

// for MoCap model - Pos[0] -> Pos[1], Pos[1] -> Pos[2]

#if IncludeNeckCalibration == 1
AnyVec3 C2_error_pos = {ce.C2Pos.Pos[0] - Main.SubjectData.Alignment.C2_x, ce.C2Pos.Pos[1] - Main.SubjectData.Alignment.C2_y, 0};
AnyVec3 C3_error_pos = {ce.C3Pos.Pos[0] - Main.SubjectData.Alignment.C3_x, ce.C3Pos.Pos[1] - Main.SubjectData.Alignment.C3_y, 0};
AnyVec3 C4_error_pos = {ce.C4Pos.Pos[0] - Main.SubjectData.Alignment.C4_x, ce.C4Pos.Pos[1] - Main.SubjectData.Alignment.C4_y, 0};
AnyVec3 C5_error_pos = {ce.C5Pos.Pos[0] - Main.SubjectData.Alignment.C5_x, ce.C5Pos.Pos[1] - Main.SubjectData.Alignment.C5_y, 0};
AnyVec3 C6_error_pos = {ce.C6Pos.Pos[0] - Main.SubjectData.Alignment.C6_x, ce.C6Pos.Pos[1] - Main.SubjectData.Alignment.C6_y, 0};
AnyVec3 C7_error_pos = {ce.C7Pos.Pos[0] - Main.SubjectData.Alignment.C7_x, ce.C7Pos.Pos[1] - Main.SubjectData.Alignment.C7_y, 0};
#endif

AnyVec3 T1_error_pos = {ce.T1Pos.Pos[0] - Main.SubjectData.Alignment.T1_x, ce.T1Pos.Pos[1] - Main.SubjectData.Alignment.T1_y, ce.T1Pos.Pos[2] - Main.SubjectData.Alignment.T1_z};
AnyVec3 T2_error_pos = {ce.T2Pos.Pos[0] - Main.SubjectData.Alignment.T2_x, ce.T2Pos.Pos[1] - Main.SubjectData.Alignment.T2_y, ce.T2Pos.Pos[2] - Main.SubjectData.Alignment.T2_z};
AnyVec3 T3_error_pos = {ce.T3Pos.Pos[0] - Main.SubjectData.Alignment.T3_x, ce.T3Pos.Pos[1] - Main.SubjectData.Alignment.T3_y, ce.T3Pos.Pos[2] - Main.SubjectData.Alignment.T3_z};
