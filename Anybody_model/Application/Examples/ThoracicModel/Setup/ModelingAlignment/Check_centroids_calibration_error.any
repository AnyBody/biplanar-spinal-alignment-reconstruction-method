AnyVar L5_error_rotZ = modelmeasures.L5GlobalRot_AngleZ - Main.SubjectData.Alignment.Angle_L5;

AnyVar T1_error_rotX = modelmeasures.T1GlobalRot_AngleX - Main.SubjectData.Alignment.CorAngle_T1;
