    AnyFloat L2GlobalRot_AngleX=L2GlobalRot.Pos[0]/pi*180;
    AnyFloat L3GlobalRot_AngleX=L3GlobalRot.Pos[0]/pi*180;
    AnyFloat L4GlobalRot_AngleX=L4GlobalRot.Pos[0]/pi*180;
    AnyFloat L5GlobalRot_AngleX=L5GlobalRot.Pos[0]/pi*180;
    
    AnyFloat T1GlobalRot_AngleY=T1GlobalRot.Pos[1]/pi*180;
