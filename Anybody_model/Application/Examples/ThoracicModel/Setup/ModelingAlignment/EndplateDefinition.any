// *** Define endplate frames ***

AnyRefNode &PostSup = PLLNodeSuperior;
AnyRefNode &AntSup = ALLNodeSuperior;
AnyRefNode &PostInf = PLLNodeInferior;
AnyRefNode &AntInf = ALLNodeInferior;

// Superior endplate
AnyRefNode Endplate_sup = {
  sRel = .PostSup.sRel;
  ARel = RotMat(sRel, .AntSup.sRel, sRel +{0.0,0.1,0.0});   
};

// Inferior endplate
AnyRefNode Endplate_inf = {
  sRel = .PostInf.sRel;
  ARel = RotMat(sRel, .AntInf.sRel, sRel +{0.0,0.1,0.0});
};

// Find general orientation of the vertebra
// determined as half of the angle delimited by sup and inf endplates
AnyRefNode Vertebral_orient = {
  sRel = (.PostSup.sRel+ .AntSup.sRel + .PostInf.sRel + .AntInf.sRel)/4;
  ARel = RotMat(sRel, (.AntSup.sRel + .AntInf.sRel)/2, sRel +{0.0,0.1,0.0});
};


