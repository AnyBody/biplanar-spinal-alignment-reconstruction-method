// Define orientations of segments for use in drivers
AnyOperationSetValue SetSegAxes = {
   
  AnyMat33 rot = {{1, 0, 0}, {0, 1, 0}, {0, 0, 1}};  
  
  AnyMat33 rot_T1 = Main.HumanModel.BodyModel.Trunk.Segments.T1Seg.Axes'; 
  AnyMat33 rot_T2 = Main.HumanModel.BodyModel.Trunk.Segments.T2Seg.Axes'; 
  AnyMat33 rot_T3 = Main.HumanModel.BodyModel.Trunk.Segments.T3Seg.Axes'; 
  AnyMat33 rot_T4 = Main.HumanModel.BodyModel.Trunk.Segments.T4Seg.Axes'; 
  AnyMat33 rot_T5 = Main.HumanModel.BodyModel.Trunk.Segments.T5Seg.Axes'; 
  AnyMat33 rot_T6 = Main.HumanModel.BodyModel.Trunk.Segments.T6Seg.Axes'; 
  AnyMat33 rot_T7 = Main.HumanModel.BodyModel.Trunk.Segments.T7Seg.Axes'; 
  AnyMat33 rot_T8 = Main.HumanModel.BodyModel.Trunk.Segments.T8Seg.Axes'; 
  AnyMat33 rot_T9 = Main.HumanModel.BodyModel.Trunk.Segments.T9Seg.Axes'; 
  AnyMat33 rot_T10 = Main.HumanModel.BodyModel.Trunk.Segments.T10Seg.Axes'; 
  AnyMat33 rot_T11 = Main.HumanModel.BodyModel.Trunk.Segments.T11Seg.Axes'; 
  AnyMat33 rot_T12 = Main.HumanModel.BodyModel.Trunk.Segments.T12Seg.Axes'; 
  AnyMat33 rot_L1 = Main.HumanModel.BodyModel.Trunk.Segments.L1Seg.Axes'; 
  AnyMat33 rot_L2 = Main.HumanModel.BodyModel.Trunk.Segments.L2Seg.Axes'; 
  AnyMat33 rot_L3 = Main.HumanModel.BodyModel.Trunk.Segments.L3Seg.Axes'; 
  AnyMat33 rot_L4 = Main.HumanModel.BodyModel.Trunk.Segments.L4Seg.Axes'; 
  AnyMat33 rot_L5 = Main.HumanModel.BodyModel.Trunk.Segments.L5Seg.Axes'; 
  AnyMat33 rot_Sacrum = Main.HumanModel.BodyModel.Trunk.Segments.SacrumSeg.Axes';
  AnyMat33 rot_Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.Axes';

  Source = {&rot_T1, &rot_T2, &rot_T3, &rot_T4, &rot_T5, &rot_T6, &rot_T7, &rot_T8, &rot_T9, &rot_T10, &rot_T11, &rot_T12,
            &rot_L1, &rot_L2, &rot_L3, &rot_L4, &rot_L5, &rot_Sacrum, &rot_Pelvis};     
  
  Target = {
    &Main.HumanModel.BodyModel.Trunk.Segments.T1Seg.T1GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.T2Seg.T2GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.T3Seg.T3GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.T4Seg.T4GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.T5Seg.T5GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.T6Seg.T6GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.T7Seg.T7GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.T8Seg.T8GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.T9Seg.T9GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.T10Seg.T10GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.T11Seg.T11GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.T12Seg.T12GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.L1Seg.L1GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.L2Seg.L2GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.L3Seg.L3GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.L4Seg.L4GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.L5Seg.L5GlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.SacrumSeg.SacrumGlobalOrient.ARel,
    &Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PelvisGlobalOrient.ARel,
  };
  
};


