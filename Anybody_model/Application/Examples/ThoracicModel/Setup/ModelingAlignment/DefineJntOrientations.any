    AnyVar Angle = -(Main.SubjectData.Alignment.Angle_C2 - Main.HumanModel.BodyModel.Trunk.PosturalMeasures.C1C2JntC2InfRot.AngleDeg)*pi/180;
    
    AnyMat33 rot_Skull = {{cos(Angle), sin(Angle), 0}, {-sin(Angle), cos(Angle), 0}, {0, 0, 1}};
    
    Source = {&rot_Skull};
    Target = {&seg_inf.C1C0JntNode.ARel};
    
  };
  
