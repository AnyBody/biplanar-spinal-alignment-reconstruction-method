AnyFixedRefFrame ShowInputPoints = {
  
  // Create a reference frame in which nodes corresponding to the input data will be displayed

  // Arbitrary point where to position S1_post point of reference
  Origin = {-0.5, 1, 0}; 
  
  
  // controls for point display
  AnyFloat PointSize = 0.005;
  AnySwitchVar Vis = On;
  AnySwitchVar FrameVis = On;
  AnyVec3 LColor = {0.6,0.6,0.9};
  AnyVec3 TColor = {0.6,0.9,0.6};
  AnyVec3 CColor = {0.9,0.9,0.6};

  AnyRefNode OriginPoint = { 
    sRel = {0,0,0};  
    ARel = RotMat(-..Alignment.SS*pi/180,z);
    
    AnyDrawNode origin_drw = { ScaleXYZ={1,1,1}*..PointSize*1.2; Visible = ..Vis; RGB = {1,1,1}*0.35;};
    
    AnyDrawRefFrame SacralSlope = {
    ScaleXYZ = 0.05*{1,0,0};
    RGB = {1,1,1}*0.35;
    };
    
  };
  
  AnyRefNode L5Point = { 
    sRel = {..Alignment.L5_x, ..Alignment.L5_y, 0};  
    ARel = RotMat(-..Alignment.Angle_L5*pi/180,z);
    
    AnyDrawNode L5_drw = { ScaleXYZ={1,1,1}*..PointSize; Visible = ..Vis; RGB = ..LColor;};
    AnyDrawRefFrame Angle_L5 = {ScaleXYZ = 0.05*{1,0,0}; Visible = ..FrameVis; RGB = ..LColor;};
    
  };
  
  AnyRefNode L4Point = { 
    sRel = {..Alignment.L4_x, ..Alignment.L4_y, 0};  
    ARel = RotMat(-..Alignment.Angle_L4*pi/180,z);

    AnyDrawNode L4_drw = { ScaleXYZ={1,1,1}*..PointSize; Visible = ..Vis; RGB = ..LColor;};
    AnyDrawRefFrame Angle_L4 = {ScaleXYZ = 0.05*{1,0,0}; Visible = ..FrameVis; RGB = ..LColor;};

  };
  
  AnyRefNode L3Point = { 
    sRel = {..Alignment.L3_x, ..Alignment.L3_y, 0};  
    ARel = RotMat(-..Alignment.Angle_L3*pi/180,z);

    AnyDrawNode L3_drw = { ScaleXYZ={1,1,1}*..PointSize; Visible = ..Vis; RGB = ..LColor;};
    AnyDrawRefFrame Angle_L3 = {ScaleXYZ = 0.05*{1,0,0}; Visible = ..FrameVis; RGB = ..LColor;};

  };
  
  AnyRefNode L2Point = { 
    sRel = {..Alignment.L2_x, ..Alignment.L2_y, 0};  
