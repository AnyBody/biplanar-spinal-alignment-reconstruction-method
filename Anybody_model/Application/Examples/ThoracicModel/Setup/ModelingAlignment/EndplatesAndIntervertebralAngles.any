        Axis1 = z;
      };
      
      // Positive values indicate lordotic angle, negative - kyphotic
      AnyFloat IVA_L5S1 = S1L5.Pos[0]/pi*180;
      AnyFloat IVA_L5L4 = L5L4.Pos[0]/pi*180;
      AnyFloat IVA_L4L3 = L4L3.Pos[0]/pi*180;
