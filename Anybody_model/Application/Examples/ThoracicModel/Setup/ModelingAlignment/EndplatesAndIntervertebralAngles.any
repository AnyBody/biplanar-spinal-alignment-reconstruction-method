HumanModel.BodyModel.Trunk.Segments.SacrumSeg = {
  
  AnyRefNode &PostSup = PLLNodeSuperior;
  AnyRefNode &AntSup = ALLNodeSuperior;
  
  AnyRefNode Endplate_sup = {
    sRel = .PostSup.sRel;
    ARel = RotMat(sRel, .AntSup.sRel, sRel +{0.0,0.1,0.0});  
    AnyDrawRefFrame Endplate_sup = {
      ScaleXYZ = 0.05*{1,0,0};
      RGB = {0,0.8,0.2};
    };    
  };
  
}; 


//    *** INTERVERTEBRAL ANGLES ***

HumanModel.BodyModel.Trunk = {
  
  AnyFolder IntervertebralAngles = {
    AnyFolder &lsegs = Main.HumanModel.BodyModel.Trunk.Segments;
    AnyFolder &tsegs = Main.HumanModel.BodyModel.Trunk.Segments;
    
    // Angles between superior endplate of inferior VB and inferior endplate of superior VB
    AnyFolder AnglesSup2Inf = {
      
      AnyKinRotational S1L5 = {
        AnyRefFrame &a0 = ..lsegs.SacrumSeg.Endplate_sup;
        AnyRefFrame &a1 = ..lsegs.L5Seg.Endplate_inf;
        Type = RotAxesAngles;
        Axis1 = z;
      }; 
      
      AnyKinRotational L5L4 = {
        AnyRefFrame &a0 = ..lsegs.L5Seg.Endplate_sup;
        AnyRefFrame &a1 = ..lsegs.L4Seg.Endplate_inf;
        Type = RotAxesAngles;
        Axis1 = z;
      };
      
      AnyKinRotational L4L3 = {
        AnyRefFrame &a0 = ..lsegs.L4Seg.Endplate_sup;
