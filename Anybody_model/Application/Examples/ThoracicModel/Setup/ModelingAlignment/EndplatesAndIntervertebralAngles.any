        Type = RotAxesAngles;
        Axis1 = z;
      };
      
      AnyKinRotational T7T6 = {
        AnyRefFrame &a0 = ..tsegs.T7Seg.Endplate_sup;
        AnyRefFrame &a1 = ..tsegs.T6Seg.Endplate_inf;
        Type = RotAxesAngles;
        Axis1 = z;
      };
      
      AnyKinRotational T6T5 = {
        AnyRefFrame &a0 = ..tsegs.T6Seg.Endplate_sup;
        AnyRefFrame &a1 = ..tsegs.T5Seg.Endplate_inf;
        Type = RotAxesAngles;
        Axis1 = z;
      };
      
      AnyKinRotational T5T4 = {
